@page
@model EcommerceTelysia.Areas.Dashboard.Pages.ProductsReviewDetails.IndexModel

@{
    ViewData["Title"] = "Product Reviews";
}

<h2 class="mb-4 text-center">📝 Product Reviews Management</h2>

<div class="text-end mb-3">
    <a asp-page="Create" class="btn btn-primary">
        <i class="fas fa-plus-circle"></i> Add Review Manually
    </a>
</div>

@if (Model.Reviews != null && Model.Reviews.Any())
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover text-center align-middle shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Reviews[0].comment)</th>
                    <th>@Html.DisplayNameFor(model => model.Reviews[0].email)</th>
                    <th>@Html.DisplayNameFor(model => model.Reviews[0].Date)</th>
                    <th>@Html.DisplayNameFor(model => model.Reviews[0].review)</th>
                    <th>@Html.DisplayNameFor(model => model.Reviews[0].ProductId)</th>
                    <th>@Html.DisplayNameFor(model => model.Reviews[0].Isviewable)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Reviews)
                {
                    <tr>
                        <td>@item.comment</td>
                        <td>@item.email</td>
                        <td>@item.Date.ToString("dd-MMM-yyyy")</td>
                        <td>@item.review</td>
                        <td>@item.ProductId</td>
                        <td>
                            @if (item.Isviewable)
                            {
                                <span class="badge bg-success">Visible</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Hidden</span>
                            }
                        </td>
                        <td>
                            <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1" title="View">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning text-center">
        No reviews available.
    </div>
}
