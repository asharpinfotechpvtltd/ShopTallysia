@page
@model EcommerceTelysia.Areas.Dashboard.Pages.WarehouseDetails.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>WareHouse</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="WareHouse.WarehouseId" />
            <div class="form-group">
                
                <label asp-for="WareHouse.WarehouseName" class="control-label"></label>
                <input asp-for="WareHouse.WarehouseName" class="form-control" required/>
                <span asp-validation-for="WareHouse.WarehouseName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="WareHouse.Location" class="control-label"></label>
                <select asp-for="WareHouse.Location" asp-items="Model.StateNames" name="location" class="form-control" required>
                    <option value="">-- Select Location --</option>
                </select>
                <span asp-validation-for="WareHouse.Location" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
