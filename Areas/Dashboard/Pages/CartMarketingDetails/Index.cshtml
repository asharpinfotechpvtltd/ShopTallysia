@page
@model EcommerceTelysia.Areas.Dashboard.Pages.CartMarketingDetails.IndexModel
@using Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Cart Marketing Entries";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">
        🛒 Cart Marketing Entries
    </h2>

  

    @if (Model.Cart != null && Model.Cart.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover shadow-sm">
                <thead class="table-dark text-center">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Cart[0].Name)</th>
                        <th>@Html.DisplayNameFor(model => model.Cart[0].Phone)</th>
                        <th>@Html.DisplayNameFor(model => model.Cart[0].ProductName)</th>
                        <th>@Html.DisplayNameFor(model => model.Cart[0].ProductId)</th>
                        <th>@Html.DisplayNameFor(model => model.Cart[0].Price)</th>
                        <th>@Html.DisplayNameFor(model => model.Cart[0].Qty)</th>
                        <th>@Html.DisplayNameFor(model => model.Cart[0].Image)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="text-center align-middle">
                    @foreach (var item in Model.Cart)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Phone</td>
                            <td>@item.ProductName</td>
                            <td>@item.ProductId</td>
                            <td>₹@item.Price</td>
                            <td>@item.Qty</td>
                            <td>
                                <img src="~/@item.Image" alt="Image" style="height: 50px;" class="rounded border" />
                            </td>
                            <td>
                              
                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Delete">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">No cart marketing entries available.</div>
    }
</div>
