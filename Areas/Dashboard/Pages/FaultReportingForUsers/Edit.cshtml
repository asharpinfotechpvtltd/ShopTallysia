@page
@model EcommerceTelysia.Areas.Dashboard.Pages.FaultReportingForUsers.EditModel

@{
    ViewData["Title"] = "Edit Ticket";
}

<h2 class="mb-3">Edit Fault Report Status</h2>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="FaultRepotingForUsers.TicketId" />

            <div class="mb-3">
                <label asp-for="FaultRepotingForUsers.Name" class="form-label"></label>
                <input asp-for="FaultRepotingForUsers.Name" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="FaultRepotingForUsers.email" class="form-label"></label>
                <input asp-for="FaultRepotingForUsers.email" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="FaultRepotingForUsers.Number" class="form-label"></label>
                <input asp-for="FaultRepotingForUsers.Number" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="FaultRepotingForUsers.Address" class="form-label"></label>
                <input asp-for="FaultRepotingForUsers.Address" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="FaultRepotingForUsers.Description" class="form-label"></label>
                <textarea asp-for="FaultRepotingForUsers.Description" class="form-control" readonly rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="FaultRepotingForUsers.Status" class="form-label"></label>
                <select asp-for="FaultRepotingForUsers.Status" class="form-select">
                    <option value="Open">Open</option>
                    <option value="Closed">Closed</option>
                </select>
                <span asp-validation-for="FaultRepotingForUsers.Status" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FaultRepotingForUsers.CreatedAt" class="form-label"></label>
                <input asp-for="FaultRepotingForUsers.CreatedAt" class="form-control" readonly />
            </div>

            <div class="mt-4">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-page="./Index" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
