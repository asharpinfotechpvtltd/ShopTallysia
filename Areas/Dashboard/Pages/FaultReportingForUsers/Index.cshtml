@page
@model EcommerceTelysia.Areas.Dashboard.Pages.FaultReportingForUsers.IndexModel

@{
    ViewData["Title"] = "Fault Reports";
}

<div class="container mt-4">
    <h2 class="mb-4">Fault Reporting List</h2>

    <div class="mb-3 text-end">
        <a class="btn btn-primary" asp-page="Create">
            <i class="fa fa-plus"></i> Create New Report
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.FaultRepotingForUsers[0].Name)</th>
                    <th>@Html.DisplayNameFor(model => model.FaultRepotingForUsers[0].email)</th>
                    <th>@Html.DisplayNameFor(model => model.FaultRepotingForUsers[0].Number)</th>
                
                    <th>@Html.DisplayNameFor(model => model.FaultRepotingForUsers[0].Status)</th>
                    <th>@Html.DisplayNameFor(model => model.FaultRepotingForUsers[0].CreatedAt)</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.FaultRepotingForUsers)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.email)</td>
                        <td>@Html.DisplayFor(modelItem => item.Number)</td>
                       
                        <td>
                            <span class="badge @(item.Status == "Open" ? "bg-warning text-dark" : "bg-success")">
                                @item.Status
                            </span>
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
                        <td class="text-center">
                            <a asp-page="./Edit" asp-route-id="@item.TicketId" class="btn btn-sm btn-warning me-1" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-page="./Details" asp-route-id="@item.TicketId" class="btn btn-sm btn-info text-white me-1" title="Details">
                                <i class="fas fa-info-circle"></i>
                            </a>
                            <a asp-page="./Delete" asp-route-id="@item.TicketId" class="btn btn-sm btn-danger" title="Delete">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
