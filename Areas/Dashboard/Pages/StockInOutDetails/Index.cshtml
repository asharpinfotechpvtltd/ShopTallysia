@page
@model EcommerceTelysia.Areas.Dashboard.Pages.StockInOutDetails.IndexModel

@{
    ViewData["Title"] = "Stock In/Out List";
}

<h1>Stock In/Out List</h1>

<p>
    <!-- Buttons to filter StockInOut by Type -->
    <a asp-page="./Index" asp-route-filterType="All" class="btn @(Model.FilterType == "All" ? "btn-primary" : "btn-secondary")">All</a>
    <a asp-page="./Index" asp-route-filterType="Sold" class="btn @(Model.FilterType == "Sold" ? "btn-danger" : "btn-secondary")">Sold</a>
    <a asp-page="./Index" asp-route-filterType="Added" class="btn @(Model.FilterType == "Added" ? "btn-success" : "btn-secondary")">Added</a>
    <a asp-page="Create" class="btn btn-primary">Create New Entry</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.StockInOut[0].SKU)</th>
            <th>@Html.DisplayNameFor(model => model.StockInOut[0].Type)</th>
            <th>@Html.DisplayNameFor(model => model.StockInOut[0].Quantity)</th>
            <th>@Html.DisplayNameFor(model => model.StockInOut[0].ActionDate)</th>
            <th>@Html.DisplayNameFor(model => model.StockInOut[0].TblWarehouseMaster)</th>
            <th>@Html.DisplayNameFor(model => model.StockInOut[0].Products)</th>
          @*   <th>Actions</th> *@
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.StockInOut)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.SKU)</td>
                <td>@Html.DisplayFor(modelItem => item.Type)</td>
                <td>@Html.DisplayFor(modelItem => item.Quantity)</td>
                <td>@Html.DisplayFor(modelItem => item.ActionDate)</td>
                <td>@Html.DisplayFor(modelItem => item.TblWarehouseMaster.WarehouseId)</td>
                <td>@Html.DisplayFor(modelItem => item.Products.Id)</td>
                <td>
                  @*   <a asp-page="./Edit" asp-route-id="@item.LogId" class="btn btn-sm btn-warning">
                        <i class="fas fa-pencil-alt"></i> Edit
                    </a>
                    <a asp-page="./Details" asp-route-id="@item.LogId" class="btn btn-sm btn-info">
                        <i class="fas fa-info-circle"></i> Details
                    </a>
                    <a asp-page="./Delete" asp-route-id="@item.LogId" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this stock entry?');">
                        <i class="fas fa-trash-alt"></i> Delete
                    </a> *@
                </td>
            </tr>
        }
    </tbody>
</table>
