@page
@model EcommerceTelysia.Areas.Dashboard.Pages.DamagedProductDetails.CreateModel

        @{
        ViewData["Title"] = "Create";
        }
        
        <h1>Create</h1>
        
    <h4>DamagedProducts</h4>
    <hr />
    <div class="row">
    <div class="col-md-4">
    <form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="DamagedProducts.ProductId" class="control-label"></label>
                <select asp-for="DamagedProducts.ProductId" class ="form-control" asp-items="ViewBag.ProductId"></select>
            </div>
           
            <div class="form-group">
                <label asp-for="DamagedProducts.DamagedQuantity" class="control-label"></label>
                <input asp-for="DamagedProducts.DamagedQuantity" class="form-control" />
                <span asp-validation-for="DamagedProducts.DamagedQuantity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DamagedProducts.DamageReason" class="control-label"></label>
                <input asp-for="DamagedProducts.DamageReason" class="form-control" />
                <span asp-validation-for="DamagedProducts.DamageReason" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DamagedProducts.WarehouseId" class="control-label"></label>
                <select asp-for="DamagedProducts.WarehouseId" class ="form-control" asp-items="ViewBag.WarehouseId"></select>
            </div>
            <div class="form-group">
                <label asp-for="DamagedProducts.ReportedOn" class="control-label"></label>
                <input asp-for="DamagedProducts.ReportedOn" class="form-control" />
                <span asp-validation-for="DamagedProducts.ReportedOn" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
