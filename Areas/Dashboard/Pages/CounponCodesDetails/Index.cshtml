@page
@model EcommerceTelysia.Areas.Dashboard.Pages.CounponCodesDetails.IndexModel
@using Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Coupon Codes";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">
        🎟️ Manage Coupon Codes
    </h2>

    <div class="text-end mb-3">
        <a asp-page="Create" class="btn btn-success shadow-sm">
            <i class="fas fa-plus-circle me-2"></i>Create New Coupon
        </a>
    </div>

    @if (Model.CouponCodes != null && Model.CouponCodes.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover shadow-sm">
                <thead class="table-primary text-center">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.CouponCodes[0].CouponCode)</th>
                        <th>@Html.DisplayNameFor(model => model.CouponCodes[0].CouponName)</th>
                        <th>@Html.DisplayNameFor(model => model.CouponCodes[0].Description)</th>
                        <th>@Html.DisplayNameFor(model => model.CouponCodes[0].ApplicableFrom)</th>
                        <th>@Html.DisplayNameFor(model => model.CouponCodes[0].ApplicableTo)</th>
                        <th>@Html.DisplayNameFor(model => model.CouponCodes[0].IsActive)</th>
                        <th>@Html.DisplayNameFor(model => model.CouponCodes[0].DiscountPercentage)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="text-center align-middle">
                    @foreach (var item in Model.CouponCodes)
                    {
                        <tr>
                            <td>@item.CouponCode</td>
                            <td>@item.CouponName</td>
                            <td>@item.Description</td>
                            <td>@item.ApplicableFrom.ToString("dd-MMM-yyyy")</td>
                            <td>@item.ApplicableTo.ToString("dd-MMM-yyyy")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>@item.DiscountPercentage %</td>
                            <td>
                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-1" title="Details">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Delete">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center">🚫 No coupon codes found.</div>
    }
</div>
