@page
@model EcommerceTelysia.Areas.Dashboard.Pages.Inventory_Details.IndexModel

@{
    ViewData["Title"] = "Inventory List";
}

<h1>Inventory List</h1>

<p>
    <a asp-page="./Index" asp-route-showOutOfStock="true" class="btn btn-danger">Products Out of Stock</a>
    <a asp-page="./Create" class="btn btn-primary">Add Inventory</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.GroupedInventory[0].SKU)</th>
            <th>@Html.DisplayNameFor(model => model.GroupedInventory[0].ProductName)</th>
            <th>@Html.DisplayNameFor(model => model.GroupedInventory[0].TotalQuantity)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.GroupedInventory)
        {
            var rowStyle = item.TotalQuantity <= 5
            ? "background-color: #f8d7da; color: #721c24;" // Bootstrap alert-danger style
            : "";

            <tr style="@rowStyle">
                <td>@Html.DisplayFor(modelItem => item.SKU)</td>
                <td>@Html.DisplayFor(modelItem => item.ProductName)</td>
                <td>@Html.DisplayFor(modelItem => item.TotalQuantity)</td>
                <td>
                    <a asp-page="./Details" asp-route-id="@item.ProductId" class="btn btn-sm btn-info text-white fw-semibold px-3">
                        <i class="fas fa-info-circle me-1"></i> Details
                    </a>
                    <form method="post"  asp-route-id="@item.ProductId"
                          onsubmit="return confirm('Are you sure you want to delete this product inventory?');"
                          style="display:inline;">
                        <button type="submit" class="btn btn-sm fw-semibold" style="background-color: #dc3545; color: white;">
                            <i class="fas fa-trash-alt me-1"></i> Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
