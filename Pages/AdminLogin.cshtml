@page
@model EcommerceTelysia.Pages.AdminLoginModel
@{
    ViewData["Title"] = "Admin Login";
}

<div class="container mt-5" style="max-width: 400px;">
    <h2 class="text-center mb-4">Admin Login</h2>

    <form method="post">
        <div class="form-group">
            <label asp-for="Admin.Email">Email</label>
            <input asp-for="Admin.Email" class="form-control" placeholder="Enter your email" required />
            <span asp-validation-for="Admin.Email" class="text-danger"></span>
        </div>

        <div class="form-group mt-3">
            <label asp-for="Admin.Password">Password</label>
            <input asp-for="Admin.Password" class="form-control" placeholder="Enter your password" type="password" required />
            <span asp-validation-for="Admin.Password" class="text-danger"></span>
        </div>

        <div class="form-group mt-4">
            <button type="submit" class="btn btn-primary w-100">Login</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
