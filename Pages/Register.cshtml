@page
@model EcommerceTelysia.Pages.RegisterModel
@{
}

<style>
    .register-form-wrapper {
        max-width: 800px;
        margin: auto;
        background: #f9f9f9;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        font-family: 'Segoe UI', sans-serif;
    }

        .register-form-wrapper h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #012a4a;
        }

    .form-group {
        margin-bottom: 15px;
        display: flex;
        flex-direction: column;
    }

    .form-row {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .form-col {
        flex: 1;
        min-width: 45%;
    }

    .register-form label {
        font-weight: 600;
        margin-bottom: 5px;
    }

        .register-form label span {
            color: red;
        }

    .register-form input,
    .register-form select {
        padding: 10px 12px;
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 1rem;
        box-sizing: border-box;
        width: 100%;
    }

        .register-form input:focus,
        .register-form select:focus {
            border-color: #007bff;
            outline: none;
        }

    .register-btn {
        width: 100%;
        padding: 12px;
        background-color: #007bff;
        border: none;
        color: white;
        font-size: 1rem;
        font-weight: bold;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s ease-in-out;
        margin-top: 10px;
    }

        .register-btn:hover {
            background-color: #0056b3;
        }

    .toggle-buttons {
        display: flex;
        justify-content: center;
        margin-bottom: 30px;
        gap: 20px;
    }

        .toggle-buttons button {
            flex: 1;
            padding: 10px;
            background-color: #e0e0e0;
            border: none;
            font-weight: bold;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

            .toggle-buttons button.active {
                background-color: #007bff;
                color: white;
            }

    @@media (max-width: 768px) {
        .form-col {
            min-width: 100%;
        }

        .toggle-buttons {
            flex-direction: column;
        }
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["FailureMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
        @TempData["FailureMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="register-form-wrapper">
    <div class="toggle-buttons">
        <button id="registerToggle" class="active" onclick="toggleForm(true)">Register</button>
        <button id="loginToggle" onclick="toggleForm(false)">Login</button>
    </div>

    <!-- Register Form -->
    <div id="registerForm">
        <h2>Account</h2>
        <form method="post" asp-page-handler="Register" class="register-form">

            <div class="form-row">
                <div class="form-col form-group">
                    <label for="Name">Full Name<span>*</span></label>
                    <input type="text" id="Name" name="Name" required />
                </div>
            </div>

            <div class="form-row">
                <div class="form-col form-group">
                    <label for="Mobile">Mobile No.<span>*</span></label>
                    <input type="tel" id="Mobile" name="Mobile" required pattern="[0-9]{10}" maxlength="10" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-col form-group">
                    <label for="Email">Email ID</label>
                    <input type="email" id="Email" name="Email" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-col form-group">
                    <label for="Password">Password<span>*</span></label>
                    <input type="password" id="Password" name="Password" required />
                </div>
            </div>

            <button type="submit" class="register-btn">Submit</button>
        </form>
    </div>


    <!-- Login Form -->
    <div id="loginForm" style="display: none;">
        <h2>Login</h2>
        <form method="post" asp-page-handler="Login" class="register-form">
            <div class="form-group">
                <label for="LoginEmail">Email<span>*</span></label>
                <input id="LoginEmail" name="LoginEmail" required />
            </div>
            <div class="form-group">
                <label for="LoginPassword">Password<span>*</span></label>
                <input type="password" id="LoginPassword" name="LoginPassword" required />
            </div>
            <button type="submit" class="register-btn">Login</button>
        </form>
    </div>
</div>

<script>
    function toggleForm(isRegister) {
        document.getElementById('registerForm').style.display = isRegister ? 'block' : 'none';
        document.getElementById('loginForm').style.display = isRegister ? 'none' : 'block';
        document.getElementById('registerToggle').classList.toggle('active', isRegister);
        document.getElementById('loginToggle').classList.toggle('active', !isRegister);
    }

    // Password Match Validation on Submit
    document.addEventListener("DOMContentLoaded", function () {
        const registerForm = document.querySelector(".register-form");
        registerForm.addEventListener("submit", function (e) {
            const password = document.getElementById("Password").value;
            const confirmPassword = document.getElementById("ConfirmPassword").value;

            if (password !== confirmPassword) {
                e.preventDefault(); // stop form submission
                alert("Passwords do not match.");
            }
        });
    });
</script>


