@page "{productid}/{productname}"
@model EcommerceTelysia.Pages.ShopDetailModel
@{
    var product = Model.Products;
    var totalReviews = Model.TotalReviews;
    var avgRating = Model.AverageReviews;
}
<div class="it-breadcrumb-area fix p-relative" data-background="assets/img/breadcrumb/breadcrumb-bg.jpg">
    <div class="it-breadcrumb-shape-1">
        <img src="assets/img/breadcrumb/breadcrumb-shape.png" alt="">
    </div>
    <div class="it-breadcrumb-transparent-text">
        <h3 class="it-breadcrumb-transparent-title">@product?.ProductName</h3>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="it-breadcrumb-content">
                    <div class="it-breadcrumb-title-box mb-25 z-index-3">
                        <h3 class="it-breadcrumb-title text-white">Shop Details</h3>
                    </div>
                    <div class="it-breadcrumb-list-wrap">
                        <div class="it-breadcrumb-list z-index-3">
                            <span><a href="/">Home</a></span>
                            <span class="dvdr">//</span>
                            <span><b>@product?.ProductName</b></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="it-shop-details__area pt-120 pb-120">
    <div class="container">
        <div class="it-shop-details__top-wrap">
            <div class="row">
                <div class="col-xl-6 col-lg-6">
                    <div class="it-shop-details__thumb-box">
                        <img src="~/@product?.Image" alt="@product?.ProductName">
                    </div>
                </div>
                <div class="col-xl-6 col-lg-6">
                    <div class="it-shop-details__right-wrap">
                        <h3 class="it-shop-details__title-sm">@product?.ProductName</h3>
                        <div class="it-shop-details__price">
                            <div class="it-shop-details__ratting">
                                @for (int i = 0; i < 5; i++)
                                {
                                    <span>
                                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M8.99725 13.695L3.7075 16.656L4.88875 10.71L0.4375 6.594L6.45775 5.88L8.99725 0.375L11.5368 5.88L17.557 6.594L13.1058 10.71L14.287 16.656L8.99725 13.695Z" fill="currentcolor"></path>
                                        </svg>
                                    </span>
                                }
                                <span class="review-text">(@totalReviews Customer reviews)</span>
                            </div>
                            <span>&#8377; @product?.Price</span>
                        </div>
                        <div class="it-shop-details__text pb-20">
                            <p>@Html.Raw(product?.Description)</p>
                        </div>
                        <form method="post" asp-page-handler="AddToCart">
                            <div class="it-shop-details__quantity-wrap">
                                <div class="it-shop-details__quantity-box d-flex align-items-center">
                                    <span>Quantity</span>
                                    <div class="it-shop-details__quantity">
                                        <div class="cart-minus"><i class="fal fa-minus"></i></div>
                                        <input type="text" name="quantity" value="1">
                                        <div class="cart-plus"><i class="fal fa-plus"></i></div>
                                    </div>
                                    <div class="it-shop-details__btn d-flex gap-2">
                                        <button type="submit" class="it-btn-green">Add To Cart</button>
                                        <button type="submit" name="isBuyNow" value="true" class="it-btn-green">Buy Now</button>
                                    </div>
                                </div>
                                <div class="it-shop-details__text-2 pb-15">
                                    <span><strong>SKU:</strong> @product?.skucode</span>
                                </div>
                            </div>
                        </form>
                        <div class="it-shop-details__social">
                            <span>Share:</span>
                            <a href="#"><i class="fab fa-facebook-f"></i></a>
                            <a href="#"><i class="fab fa-instagram"></i></a>
                            <a href="#"><i class="fab fa-twitter"></i></a>
                            <a href="#"><i class="fab fa-pinterest-p"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row align-items-center">
            <div class="col-xl-12">
                <div class="it-shop-details__review-box mb-50">
                    <h4 class="postbox__details-title">Client Reviews</h4>
                    @if (Model.TotalReviews > 0)
                    {
                        <div class="it-shop-details__review pt-10 d-flex align-items-start">
                            <div class="it-shop-details__review-thumb">
                                <img src="/assets/img/product/product-details/reviewer.png" alt="Reviewer">
                            </div>
                            <div class="it-shop-details__author-info">
                                <span><strong>by @Model.Reviews?.email</strong> / @Model.Reviews?.Date.ToShortDateString()</span>
                                <div class="it-shop-details__star">
                                    @for (int i = 0; i < Model.Reviews?.review; i++)
                                    {
                                        <i class="fas fa-star"></i>
                                    }
                                </div>
                                <p>@Model.Reviews?.comment</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="col-xl-12">
                <div class="it-shop-details-contact-wrap">
                    <div class="it-contact-wrap">
                        <h4 class="postbox__details-title mb-20">Add Your Review</h4>
                        <form method="post" asp-page-handler="Review">
                            <div class="row">
                                <div class="col-xl-6 col-lg-6 col-12 mb-20">
                                    <input name="name" type="text" class="form-control" placeholder="Your Name*">
                                </div>
                                <div class="col-xl-6 col-lg-6 col-12 mb-20">
                                    <input name="email" type="email" class="form-control" placeholder="Email Address*">
                                </div>
                                <div class="col-12 mb-20">
                                    <textarea name="review" class="form-control" placeholder="Write Your Message*"></textarea>
                                </div>
                                <div class="col-12 mb-20">
                                    <label>Rating (1 to 5):</label>
                                    <input name="star" type="number" min="1" max="5" class="form-control">
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="it-btn-green">Submit Review</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
